{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/ingest-profile-alerts",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/ingest-daily",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/ingest-weekly-grid",
      "schedule": "0 7 1 * *"
    },
    {
      "path": "/api/cron/process-market-refresh",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/process-scheduled-sms",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-customer-imports",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-outreach-campaigns",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-scheduled-posts",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/ingest-ai-visibility",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/admin-weekly-digest",
      "schedule": "0 8 * * 1"
    }
  ]
}
